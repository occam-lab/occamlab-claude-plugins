{
  "description": "ASD-STE100 — per-turn style reminder, plus a Stop-hook prose linter.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ste100_remind.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ste100_lint.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
