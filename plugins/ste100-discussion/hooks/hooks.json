{
  "description": "ASD-STE100 — per-turn style reminder, plus a blocking check on every prose file written.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ste100_remind.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/ste100_check_file.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
